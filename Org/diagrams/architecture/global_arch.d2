 vars: {
    d2-config: {
      layout-engine: elk
      theme-id: 1
    }
  }

  grid-columns: 1

  title: BQTI System Architecture {
    near: top-center
    shape: text
    style.font-size: 30
    style.bold: true
  }

  peer_a: Peer A {
    direction: right
    style.font-size: 24

    trust: Trust Layer (--features tee) {
      style.font-size: 24
      tee: Keystone Enclave\nPoW · Sign · Attest {
        style.fill: "#d4edda"
        style.font-size: 24
      }
      soft: Software Keys\nPoW · Sign\n(fallback) {
        style.fill: "#fff3cd"
        style.stroke-dash: 4
        style.font-size: 24
      }
    }

    app: Application Layer {
      style.font-size: 24
      dht: Kademlia DHT { style.font-size: 24 }
      pex: PEX Gossip { style.font-size: 24 }
      bep: BitTorrent Protocol { style.font-size: 24 }
    }
    transport: Transport Layer {
      style.font-size: 24
      quic: QUIC (TLS 1.3) { style.font-size: 24 }
    }
    anon: Anonymity Layer {
      style.stroke-dash: 4
      style.font-size: 24
      sam: SAM Bridge { style.font-size: 24 }
      i2pd: i2pd { style.font-size: 24 }
      sam -> i2pd
    }

    trust.tee -> app: Ed25519 identity {
      style.stroke: "#28a745"
      style.font-size: 24
    }
    trust.soft -> app: Ed25519 identity {
      style.stroke-dash: 4
      style.stroke: "#ffc107"
      style.font-size: 24
    }

    app.dht -> transport.quic
    app.pex -> transport.quic
    app.bep -> transport.quic

    transport.quic -> anon.sam: optional {
      style.stroke-dash: 4
      style.font-size: 24
    }
  }

  peer_b: Peer B {
    direction: right
    style.font-size: 24

    trust: Trust Layer (--features tee) {
      style.font-size: 24
      tee: Keystone Enclave\nPoW · Sign · Attest {
        style.fill: "#d4edda"
        style.font-size: 24
      }
      soft: Software Keys\nPoW · Sign\n(fallback) {
        style.fill: "#fff3cd"
        style.stroke-dash: 4
        style.font-size: 24
      }
    }

    app: Application Layer {
      style.font-size: 24
      dht: Kademlia DHT { style.font-size: 24 }
      pex: PEX Gossip { style.font-size: 24 }
      bep: BitTorrent Protocol { style.font-size: 24 }
    }
    transport: Transport Layer {
      style.font-size: 24
      quic: QUIC (TLS 1.3) { style.font-size: 24 }
    }
    anon: Anonymity Layer {
      style.stroke-dash: 4
      style.font-size: 24
      sam: SAM Bridge { style.font-size: 24 }
      i2pd: i2pd { style.font-size: 24 }
      sam -> i2pd
    }

    trust.tee -> app: Ed25519 identity {
      style.stroke: "#28a745"
      style.font-size: 24
    }
    trust.soft -> app: Ed25519 identity {
      style.stroke-dash: 4
      style.stroke: "#ffc107"
      style.font-size: 24
    }

    app.dht -> transport.quic
    app.pex -> transport.quic
    app.bep -> transport.quic

    transport.quic -> anon.sam: optional {
      style.stroke-dash: 4
      style.font-size: 24
    }
  }

  peer_a.transport.quic <-> peer_b.transport.quic: direct QUIC {
    style.stroke-dash: 4
    style.font-size: 18
    style.bold: false
  }

  peer_a.anon.i2pd <-> peer_b.anon.i2pd: I2P Network {
    style.stroke-dash: 4
    style.font-size: 18
    style.bold: false
  }
